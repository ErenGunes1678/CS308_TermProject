{
  "info": {
    "name": "CS308 Term Project API",
    "_postman_id": "cs308-term-project",
    "description": "All endpoints for the CS308 Term Project backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Verify the backend server is running."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Create a new user account. Returns a JWT token on success.\n\n**Required fields:** name, email, password\n\n**Errors:**\n- 409 — email already registered"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate and receive a JWT token.\n\n**Required fields:** email, password\n\n**Errors:**\n- 401 — invalid credentials"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            },
            "description": "Retrieve all products in the inventory."
          }
        },
        {
          "name": "Add Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Headphones\",\n  \"model\": \"WH-1000XM5\",\n  \"serial_number\": \"SN-2024-001\",\n  \"description\": \"Noise-cancelling over-ear headphones\",\n  \"quantity_in_stock\": 50,\n  \"price\": 299.99,\n  \"warranty_status\": true,\n  \"distributor_info\": \"Sony Electronics\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            },
            "description": "Add a new product to the inventory.\n\n**Required fields:** name, price\n\n**Optional fields:** model, serial_number, description, quantity_in_stock (default 0), warranty_status (default false), distributor_info\n\n**Errors:**\n- 400 — missing name or price\n- 409 — serial_number already exists"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Headphones Pro\",\n  \"price\": 349.99,\n  \"quantity_in_stock\": 30,\n  \"warranty_status\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/products/:id",
              "host": ["{{base_url}}"],
              "path": ["products", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID of the product to update"
                }
              ]
            },
            "description": "Update an existing product. Only include the fields you want to change.\n\n**Path Variable:** id — product ID\n\n**All body fields are optional:** name, model, serial_number, description, quantity_in_stock, price, warranty_status, distributor_info\n\n**Errors:**\n- 404 — product not found"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/:id",
              "host": ["{{base_url}}"],
              "path": ["products", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID of the product to delete"
                }
              ]
            },
            "description": "Remove a product from the inventory.\n\n**Path Variable:** id — product ID\n\n**Errors:**\n- 404 — product not found"
          }
        }
      ]
    }
  ]
}
